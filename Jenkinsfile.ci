
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_EXE = 'C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check tools') {
            steps {
                bat 'python --version'
                bat '"%DOCKER_EXE%" --version'
                bat '"%DOCKER_EXE%" compose version'
            }
        }

        stage('Install dependencies') {
            steps {
                bat 'python -m pip install -r cars-service/requirements.txt -r owners-service/requirements.txt'
            }
        }

        // тесты каждого сервиса - отдельным процессом из своей папки
        stage('Tests') {
            steps {
                dir('cars-service') {
                    bat 'python -m pytest tests -v'
                }
                dir('owners-service') {
                    bat 'python -m pytest tests -v'
                }
            }
        }

        stage('Python syntax check') {
            steps {
                bat 'python -m py_compile cars-service/app.py cars-service/clients.py cars-service/database.py cars-service/config.py'
                bat 'python -m py_compile owners-service/app.py owners-service/clients.py owners-service/database.py owners-service/config.py'
            }
        }

        stage('Validate Docker Compose') {
            steps {
                bat '"%DOCKER_EXE%" compose config -q'
            }
        }

        stage('Build Docker images (CI only)') {
            steps {
                script {
                    def branchTag = (env.BRANCH_NAME ?: 'manual')
                        .toLowerCase()
                        .replaceAll(/[^a-z0-9_.-]/, '-')

                    env.CI_IMAGE_TAG = "${branchTag}-${env.BUILD_NUMBER}"
                }

                bat "\"%DOCKER_EXE%\" build -t car-accounting-ci/cars-service:${env.CI_IMAGE_TAG} cars-service"
                bat "\"%DOCKER_EXE%\" build -t car-accounting-ci/owners-service:${env.CI_IMAGE_TAG} owners-service"
                bat "\"%DOCKER_EXE%\" build -t car-accounting-ci/gateway:${env.CI_IMAGE_TAG} gateway"
            }
        }
    }

    post {
        success {
            echo 'CI completed successfully. Deployment was not performed.'
        }
    }
}
